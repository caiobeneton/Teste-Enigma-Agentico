{
  "name": "nexo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "api"
  ],
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@nexo/web",
    "dev:api": "npm run dev --workspace=@nexo/api",
    "start": "npm run start --workspace=@nexo/api",
    "test": "npm run test --workspace=@nexo/api",
    "migrate": "npm run migrate --workspace=@nexo/api",
    "build": "npm run build --workspace=@nexo/web",
    "preview": "npm run preview --workspace=@nexo/web"
  }
}
